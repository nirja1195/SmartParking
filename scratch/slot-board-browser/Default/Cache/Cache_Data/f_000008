    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    // 1. PARKING ACTIVITY BAR CHART
    const activityLabels = ["Sep 19","Sep 20","Sep 21","Sep 22","Sep 23","Sep 24","Sep 25"];
    const entriesData = [0,0,9,7,12,0,0];
    const exitsData = [0,0,9,7,12,0,0];

    const ctxActivity = document.getElementById('parkingActivityChart').getContext('2d');
    new Chart(ctxActivity, {
        type: 'bar',
        data: {
            labels: activityLabels,
            datasets: [
                {
                    label: 'Entries',
                    data: entriesData,
                    backgroundColor: '#F9B91E',
                    borderRadius: 4,
                    barPercentage: 0.6,
                    categoryPercentage: 0.5
                },
                {
                    label: 'Exits',
                    data: exitsData,
                    backgroundColor: '#101828',
                    borderRadius: 4,
                    barPercentage: 0.6,
                    categoryPercentage: 0.5
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: '#64748B', font: { family: 'Inter', size: 11 } }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: '#F1F5F9' },
                    ticks: { color: '#64748B', font: { family: 'Inter', size: 11 } }
                }
            }
        }
    });

    // 2. SLOT STATUS DONUT CHART
    const slotAvail = 1577;
    const slotOcc = 1368;
    const slotMaint = 0;
    const slotRes = 0;
    const slotBlock = 0;

    const donutLabels = ['Available', 'Occupied', 'Maintenance'];
    const donutData = [slotAvail, slotOcc, slotMaint];
    const donutColors = ['#10B981', '#F9B91E', '#9CA3AF'];

    if (slotRes > 0) {
        donutLabels.push('Reserved');
        donutData.push(slotRes);
        donutColors.push('#3B82F6');
    }
    if (slotBlock > 0) {
        donutLabels.push('Blocked');
        donutData.push(slotBlock);
        donutColors.push('#374151');
    }

    const ctxDonut = document.getElementById('slotStatusDonutChart').getContext('2d');
    new Chart(ctxDonut, {
        type: 'doughnut',
        data: {
            labels: donutLabels,
            datasets: [{
                data: donutData,
                backgroundColor: donutColors,
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '76%',
            plugins: {
                legend: { display: false },
                tooltip: { enabled: true }
            }
        }
    });
});
</script>
