    <style>
        :root {
            --sp-yellow: #F9B91E;
            --sp-yellow-light: #FFF8E7;
            --sp-yellow-hover: #FEF0C7;
            --sp-dark: #101828;
            --sp-navy: #0F172A;
            --sp-gray-muted: #64748B;
            --sp-border: #E2E8F0;
            --sp-bg-light: #F8FAFC;
            --sp-green: #10B981;
            --sp-green-light: #DCFCE7;
            --sp-green-text: #15803D;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--sp-bg-light);
            color: var(--sp-dark);
            min-height: 100vh;
        }

        /* Top Header Navbar */
        .admin-header {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--sp-border);
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .brand-logo-box {
            width: 36px;
            height: 36px;
            background-color: var(--sp-dark);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sp-yellow);
            font-weight: 800;
            font-size: 1.15rem;
        }

        .brand-name {
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.1;
            color: var(--sp-dark);
        }

        .brand-name span {
            color: var(--sp-yellow);
        }

        .brand-tagline {
            font-size: 0.68rem;
            color: var(--sp-gray-muted);
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .header-divider {
            width: 1px;
            height: 28px;
            background-color: var(--sp-border);
            margin: 0 1rem;
        }

        /* Top Header Search Input */
        .header-search-box {
            position: relative;
            max-width: 280px;
            width: 100%;
        }

        .header-search-box input {
            background-color: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 20px;
            padding-left: 2.2rem;
            font-size: 0.85rem;
            height: 36px;
        }

        .header-search-box i {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.88rem;
        }

        /* Dark Sidebar Styling */
        .admin-sidebar {
            width: 250px;
            background-color: #0F172A;
            color: #94A3B8;
            min-height: calc(100vh - 64px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.25s ease-in-out;
        }

        .admin-sidebar.collapsed {
            margin-left: -250px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1rem 0.75rem;
            margin: 0;
        }

        .sidebar-item {
            margin-bottom: 0.25rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            padding: 0.65rem 1rem;
            color: #94A3B8;
            font-weight: 500;
            font-size: 0.92rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .sidebar-link i {
            font-size: 1.15rem;
            margin-right: 0.85rem;
            color: #64748B;
            width: 20px;
            text-align: center;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: #1E293B;
        }

        .sidebar-link.active {
            color: var(--sp-dark);
            background-color: var(--sp-yellow);
            font-weight: 700;
        }

        .sidebar-link.active i {
            color: var(--sp-dark);
        }

        .sidebar-group-header {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #475569;
            font-weight: 700;
            padding: 1rem 1rem 0.35rem;
        }

        /* Sidebar Footer Image Card */
        .sidebar-bottom-card {
            margin: 1rem 0.75rem 0.75rem;
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            height: 160px;
            background-color: #1E293B;
        }

        .sidebar-bottom-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.55;
        }

        .sidebar-bottom-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: #FFFFFF;
            font-weight: 800;
            font-size: 1rem;
            line-height: 1.15;
            letter-spacing: 0.05em;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        .sidebar-copyright {
            padding: 0 1rem 1rem;
            font-size: 0.7rem;
            color: #64748B;
        }

        /* Profile & Dropdowns */
        .profile-btn {
            background: transparent;
            border: none;
            padding: 0;
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .avatar-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #F1F5F9;
            border: 1px solid var(--sp-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sp-dark);
            font-size: 1.1rem;
        }

        /* Card Styling */
        .card-custom {
            background-color: #FFFFFF;
            border: 1px solid var(--sp-border);
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.02);
        }

        .yellow-icon-badge {
            width: 44px;
            height: 44px;
            background-color: #FEF3C7;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sp-dark);
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        /* Location Type Soft Pastel Badges matching screenshot */
        .badge-type-commercial { background-color: #E0F2FE; color: #0369A1; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-airport { background-color: #F3E8FF; color: #6B21A8; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-office { background-color: #FFEDD5; color: #C2410C; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-transit { background-color: #DCFCE7; color: #15803D; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-hospital { background-color: #FCE7F3; color: #9D174D; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-educational { background-color: #FEF3C7; color: #92400E; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-type-public { background-color: #E0F2FE; color: #1D4ED8; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }

        /* Badge Status */
        .badge-status-active { background-color: #DCFCE7; color: #15803D; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }
        .badge-status-inactive { background-color: #E2E8F0; color: #475569; font-weight: 600; padding: 0.35em 0.75em; border-radius: 8px; font-size: 0.78rem; }

        /* Small action icon buttons */
        .btn-action-square {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: none;
            background-color: #F1F5F9;
            color: #475569;
            font-size: 0.88rem;
            transition: all 0.15s ease;
        }

        .btn-action-square:hover {
            background-color: #E2E8F0;
            color: #0F172A;
        }

        .btn-action-square-delete {
            background-color: #FEE2E2;
            color: #EF4444;
        }

        .btn-action-square-delete:hover {
            background-color: #FCA5A5;
            color: #991B1B;
        }

        /* Responsive Layout */
        @media (max-width: 991.98px) {
            .admin-sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                z-index: 1020;
                height: calc(100vh - 64px);
                margin-left: -250px;
            }
            .admin-sidebar.show {
                margin-left: 0;
            }
        }
    </style>
